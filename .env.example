# Hindsight AI Memory Configuration
# For local or managed Hindsight instance (e.g. http://localhost:8888 or cloud endpoint)
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Neon PostgreSQL Database Connection String
# Example: postgresql://username:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# LLM Provider Configuration
# Supported providers: groq, openai, mock
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
